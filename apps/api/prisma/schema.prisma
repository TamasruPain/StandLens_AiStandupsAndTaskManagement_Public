// ============================================================
// StandLens — Prisma Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum DigestVisibility {
  EVERYONE
  ADMINS_ONLY
  OWNER_ONLY
}

enum DigestTriggerPermission {
  ADMINS_AND_OWNER
  EVERYONE
}

// ============================================================
// MODELS
// ============================================================

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relationships
  memberships     TeamMember[]
  joinRequests    JoinRequest[]
  standups        Standup[]
  digests         Digest[]       @relation("GeneratedDigests")
  notifications   Notification[] @relation("UserNotifications")
  createdProjects Project[]
  taskAssignees   TaskAssignee[]
  createdTasks    Task[]         @relation("CreatedTasks")
  comments        TaskComment[]
  taskActivities  TaskActivity[]

  // BetterAuth required models support
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Team {
  id                      String                  @id @default(cuid())
  name                    String
  companyName             String
  inviteCode              String                  @unique @default(cuid())
  discoverable            Boolean                 @default(true)
  digestVisibility        DigestVisibility        @default(EVERYONE)
  digestTriggerPermission DigestTriggerPermission @default(ADMINS_AND_OWNER)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  // Relationships
  members      TeamMember[]
  joinRequests JoinRequest[]
  standups     Standup[]
  digests      Digest[]
  trends       TrendAnalysis[]
  projects     Project[]

  @@map("team")
}

model TeamMember {
  id       String   @id @default(cuid())
  userId   String
  teamId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@map("team_member")
}

model JoinRequest {
  id          String            @id @default(cuid())
  userId      String
  teamId      String
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  respondedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@map("join_request")
}

model Standup {
  id          String   @id @default(cuid())
  userId      String
  teamId      String
  yesterday   String
  today       String
  blockers    String?
  standupDate DateTime @default(now()) @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId, standupDate])
  @@map("standup")
}

model Digest {
  id            String   @id @default(cuid())
  teamId        String
  generatedById String
  summary       String
  highlights    String   // Stored as JSON string or formatted markdown
  concerns      String   // Stored as JSON string or formatted markdown
  aiModel       String   // e.g. "deepseek/deepseek-r1:free"
  standupCount  Int      @default(0)
  digestDate    DateTime @default(now()) @db.Date
  createdAt     DateTime @default(now())

  team        Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  generatedBy User @relation("GeneratedDigests", fields: [generatedById], references: [id], onDelete: Cascade)

  @@unique([teamId, digestDate])
  @@map("digest")
}

model TrendAnalysis {
  id                String   @id @default(cuid())
  teamId            String
  weeklyTrends      String
  recurringBlockers String
  velocityInsights  String
  weekStartDate     DateTime @db.Date
  createdAt         DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, weekStartDate])
  @@map("trend_analysis")
}

enum NotificationType {
  JOIN_REQUEST
  REQUEST_APPROVED
  REQUEST_DECLINED
  DIGEST_READY
  STANDUP_REMINDER
  TASK_ASSIGNED
  TASK_REVIEW_REQUESTED
  TASK_COMPLETED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id          String   @id @default(cuid())
  teamId      String
  name        String
  description String?
  color       String   @default("#5B46F6")
  archived    Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([teamId, name])
  @@map("project")
}

model Task {
  id             String       @id @default(cuid())
  projectId      String
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  createdById    String
  dueDate        DateTime?
  order          Int          @default(0)
  completionDesc String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User          @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)
  assignees TaskAssignee[]
  comments  TaskComment[]
  subtasks  TaskSubtask[]
  activities TaskActivity[]

  @@map("task")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("task_comment")
}

model TaskAssignee {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_assignee")
}

model TaskSubtask {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_subtask")
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("task_activity")
}
